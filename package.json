{
  "name": "audioplotter",
  "version": "1.2.0",
  "private": true,
  "homepage": "https://audioplotter.ars.is",
  "repository": "https://github.com/eins78/audioplotter",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "serve": "serve dist -l 3000",
    "dev-audio-server": "serve --cors -l 57915 ../../Inputs/Amen\\ Break/",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "pnpm test && pnpm test:browser && pnpm test:e2e",
    "lint": "prettier --check .",
    "ci": "pnpm lint && pnpm test && pnpm test:browser && pnpm build && pnpm test:e2e"
  },
  "dependencies": {
    "audio-buffer-utils": "^5.1.2",
    "audio-context": "^1.0.3",
    "bootstrap": "^5.3.3",
    "lodash.debounce": "^4.0.8",
    "prop-types": "^15.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-helmet-async": "^2.0.5",
    "react-svg-path": "^1.11.0",
    "react-toggle": "^4.1.2",
    "workbox-build": "^7.3.0",
    "workbox-window": "^7.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@prettier/plugin-ruby": "^3.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/lodash.debounce": "^4.0.9",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser": "^4.0.15",
    "@vitest/browser-playwright": "^4.0.15",
    "@vitest/ui": "^4.0.15",
    "prettier": "^3.4.2",
    "sass": "^1.83.2",
    "serve": "^14.2.4",
    "typescript": "^5.9.3",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^4.0.15",
    "vitest-browser-react": "^2.0.2"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120
  },
  "engines": {
    "node": "^24.0.0"
  },
  "packageManager": "pnpm@10.22.0+sha512.bf049efe995b28f527fd2b41ae0474ce29186f7edcb3bf545087bd61fbbebb2bf75362d1307fda09c2d288e1e499787ac12d4fcb617a974718a6051f2eee741c"
}
